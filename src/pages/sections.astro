---
import PortalShell from '../layouts/PortalShell.astro';
import Portals from '../components/sections/Portals.astro';
import EventsSection from '../components/sections/EventsSection.astro';
import EventsHallSection from '../components/sections/EventsHallSection.astro';
import NewsSection from '../components/sections/NewsSection.astro';
import NewsRelatedSection from '../components/sections/NewsRelatedSection.astro';
import RoomsRelatedSection from '../components/sections/RoomsRelatedSection.astro';
import VacaturesSection from '../components/sections/VacaturesSection.astro';
import LogosSection from '../components/sections/LogosSection.astro';
import GallerySection from '../components/sections/GallerySection.astro';
import TeamSection from '../components/sections/TeamSection.astro';
---
<PortalShell title="Organisms — Page sections — Opek - Design System" active="sections">

  <div class="vb-lib__head">
    <h1 class="vb-lib__title">Organisms &mdash; Page sections</h1>
  </div>

  <div class="flex flex-col gap-12">

    <section id="portals" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">Portals (usps)</h2>
      <Portals />
    </section>

    <section id="events" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">Events</h2>
      <EventsSection />
    </section>

    <section id="events-hall" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">Events — hall</h2>
      <EventsHallSection />
    </section>

    <section id="news" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">News section</h2>
      <NewsSection />
    </section>

    <section id="news-related" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">Related news (Andere nieuws)</h2>
      <NewsRelatedSection />
    </section>

    <section id="rooms-related" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">Related rooms (Andere ruimtes)</h2>
      <RoomsRelatedSection />
    </section>

    <section id="vacatures" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">Vacatures (Werk mee)</h2>
      <VacaturesSection />
    </section>

    <section id="logos" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">Logos / bewoners</h2>
      <LogosSection />
    </section>

    <section id="gallery" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">Gallery</h2>
      <GallerySection />
    </section>

    <section id="team" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">Team section</h2>
      <TeamSection />
    </section>
  </div>

  <script is:inline>
    (function () {
      document.querySelectorAll('.vb-sec__grid--slider').forEach(function (el) {
        var down = false, moved = false, startX = 0, startLeft = 0;
        el.addEventListener('pointerdown', function (e) {
          if (el.scrollWidth <= el.clientWidth) return; // only when scrollable (mobile)
          down = true; moved = false; startX = e.clientX; startLeft = el.scrollLeft;
          el.setPointerCapture(e.pointerId);
        });
        el.addEventListener('pointermove', function (e) {
          if (!down) return;
          var dx = e.clientX - startX;
          if (!moved && Math.abs(dx) > 4) { moved = true; el.classList.add('is-dragging'); }
          if (moved) el.scrollLeft = startLeft - dx;
        });
        function end() { if (!down) return; down = false; setTimeout(function () { el.classList.remove('is-dragging'); }, 0); }
        el.addEventListener('pointerup', end);
        el.addEventListener('pointercancel', end);
        el.addEventListener('click', function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
      });
    })();
  </script>
</PortalShell>
