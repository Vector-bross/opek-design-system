---
/**
 * ORGANISMS — Navbar. Atoms + tokens only.
 * Each variant is a tile with a Mobile switch (like the atoms/tiles):
 * toggling swaps the desktop rendering for the mobile navbar.
 */
import logo from '../../assets/opek/logo.svg?raw';
import logoDark from '../../assets/opek/logo.svg?raw';
import chevron from '../../assets/opek/icons/Down_Arrow_5.svg?raw';
import arrowRight from '../../assets/opek/icons/arrow-right.svg?raw';
import iconClose from '../../assets/opek/icons/icon-Close.svg?raw';
import iconHamburger from '../../assets/opek/icons/icon-Hamburger 7.svg?raw';
import iconInsta from '../../assets/opek/icons/social/Instagram.svg?raw';
import iconLinkedin from '../../assets/opek/icons/social/linkedin-mono.svg?raw';
// Agenda submenu = Figma node 18304:17584. Over OPEK submenu = placeholder pending its node.
const agendaSub = ['Voorstellingen', 'Concerten', "Expo's", 'Festiviteiten', 'Workshops', 'Kampen'];
const overSub = ['Onze werking', 'Team', 'Vacatures', 'Pers'];
const navlinks = [
  { label: 'Agenda', sub: agendaSub, cta: 'Bekijk de volledige agenda' },
  { label: 'Zaalverhuur' },
  { label: 'Over OPEK', sub: overSub, cta: 'Meer over OPEK' },
  { label: 'Café Entrepot' },
  { label: 'Contact' },
];
const services = ['Service name', 'Service name', 'Service name', 'Service name'];
const burger = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`;
const xicon = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`;
---
<div class="flex flex-col gap-8">

  <!-- Navbar (default) — desktop / mobile -->
  <div class="flex flex-col gap-4" data-tile>
    <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
      <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Navbar — desktop / mobile<span class="vb-cap-id">#navbar</span></span>
      <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
    </div>
    <div class="vb-nav-demo">
      <!-- Desktop -->
      <nav class="vb-navbar vb-nav-desk">
        <div class="vb-navbar__start">
          <a href="#" class="vb-navbar__logo" set:html={logo}></a>
          <div class="vb-navbar__links">
            {navlinks.map((l) => (
              l.sub ? (
                <div class="vb-navbar__item">
                  <span class="vb-navbar__link">{l.label}<span class="vb-navbar__chev" set:html={chevron}></span></span>
                  <div class="vb-submenu">
                    {l.sub.map((s) => (<a href="#" class="vb-submenu__link">{s}</a>))}
                    <a href="#" class="vb-btn vb-btn--small vb-btn--secondary vb-submenu__cta">{l.cta}<span class="vb-submenu__arrow" set:html={arrowRight}></span></a>
                  </div>
                </div>
              ) : (
                <a href="#" class="vb-navbar__link">{l.label}</a>
              )
            ))}
          </div>
        </div>
        <div class="vb-navbar__langsw">
          <a href="#" class="vb-navbar__langsw-item is-active">NL</a>
          <a href="#" class="vb-navbar__langsw-item">EN</a>
        </div>
      </nav>
      <!-- Mobile -->
      <div class="vb-navm-wrap">
        <div class="vb-navm" data-navm>
          <div class="vb-navm__bar">
            <a href="#" class="vb-navm__logo" set:html={logo}></a>
            <button type="button" class="vb-navm__burger" data-navm-toggle aria-label="Menu">
              <span class="vb-navm__bars" set:html={iconHamburger}></span>
              <span class="vb-navm__x" set:html={iconClose}></span>
            </button>
          </div>
          <div class="vb-navm__panel">
            <div class="vb-navm__links">
              {navlinks.map((l) => (
                <div class="vb-navm__group">
                  {l.sub ? (
                    <>
                      <button type="button" class="vb-navm__mitem" data-navm-sub aria-expanded="false">{l.label}<span class="vb-navm__chev" set:html={chevron}></span></button>
                      <div class="vb-navm__sub">
                        <div class="vb-submenu vb-submenu--mobile">
                          {l.sub.map((s) => (<a href="#" class="vb-submenu__link">{s}</a>))}
                          <a href="#" class="vb-btn vb-btn--small vb-btn--secondary vb-submenu__cta">{l.cta}<span class="vb-submenu__arrow" set:html={arrowRight}></span></a>
                        </div>
                      </div>
                    </>
                  ) : (
                    <a href="#" class="vb-navm__mitem">{l.label}</a>
                  )}
                </div>
              ))}
            </div>
            <div class="vb-navm__lang">
              <a href="#" class="vb-navbar__langsw-item is-active">NL</a>
              <a href="#" class="vb-navbar__langsw-item">EN</a>
            </div>
            <div class="vb-navm__contact">
              <div class="vb-navm__addr">
                <p class="vb-navm__addrline">Vaartkom<br />3000 Leuven</p>
                <div class="vb-navm__contactlines">
                  <p class="vb-navm__phone">016 29 55 49</p>
                  <a href="#" class="vb-navm__email">info@opek.be</a>
                </div>
                <div class="vb-navm__socials">
                  <a href="#" class="vb-navm__social" aria-label="Instagram" set:html={iconInsta}></a>
                  <a href="#" class="vb-navm__social" aria-label="LinkedIn" set:html={iconLinkedin}></a>
                </div>
              </div>
              <a href="#" class="vb-btn vb-ctam__btn vb-ctam__btn--lg vb-navm__contactbtn">Contact &amp; route</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<script is:inline>
  (function () {
    // Mobile switch: swap desktop <-> mobile rendering per tile (scoped to nav tiles).
    document.querySelectorAll('.vb-nav-demo').forEach(function (demo) {
      var tile = demo.closest('[data-tile]');
      var t = tile && tile.querySelector('[data-mobile-toggle]');
      if (!t) return;
      t.addEventListener('change', function () { demo.classList.toggle('is-mobile', t.checked); });
    });
    // Mobile navbar interactivity (hamburger + Services expand).
    document.querySelectorAll('[data-navm]').forEach(function (nav) {
      var toggle = nav.querySelector('[data-navm-toggle]');
      if (toggle) toggle.addEventListener('click', function () { nav.classList.toggle('is-open'); });
      nav.querySelectorAll('[data-navm-sub]').forEach(function (b) {
        b.addEventListener('click', function () { b.setAttribute('aria-expanded', b.getAttribute('aria-expanded') === 'true' ? 'false' : 'true'); });
      });
    });
  })();
</script>
