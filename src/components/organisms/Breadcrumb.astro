---
/**
 * ORGANISMS — Breadcrumb. OPEK Figma 18263:11516. Tokens only.
 * Green bar. Links = Pitch Semibold caps (underlined). "/" separator (Pitch).
 * Current = Pitch Medium caps, no underline. All black.
 */
const items = ['Home', 'Agenda', 'Voorstellingen'];
const current = 'Titel evenement';
---
<div class="flex flex-col gap-4" data-tile data-bctile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Breadcrumb — desktop / mobile<span class="vb-cap-id">#breadcrumb</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>
  <nav class="vb-breadcrumb" aria-label="Breadcrumb">
    <div class="vb-breadcrumb__inner">
      {items.map((label) => (
        <>
          <a href="#" class="vb-breadcrumb__link">{label}</a>
          <span class="vb-breadcrumb__sep" aria-hidden="true">/</span>
        </>
      ))}
      <span class="vb-breadcrumb__current" aria-current="page">{current}</span>
    </div>
  </nav>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-bctile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var el = tile.querySelector('.vb-breadcrumb');
      if (t && el) t.addEventListener('change', function () { el.classList.toggle('is-mobile', t.checked); });
    });
  })();
</script>
