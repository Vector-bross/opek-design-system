---
/**
 * ORGANISMS — Header. Atoms + molecules + tokens only.
 * Layouts: Title page (image right/left), Blog, Job (reuses JobOpening),
 * PersonProfile, LocationDetail, ContactUs. Full-bleed bands, content 1120.
 * Each layout is a tile with a Mobile switch.
 */
import logo from '../../assets/brand/logo-vb.svg?raw';
const placeholder = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const socialRaw = import.meta.glob('../../assets/icons/social/*.svg', { query: '?raw', import: 'default', eager: true });
const order = ['linkedin', 'instagram', 'facebook', 'tiktok', 'youtube'];
const socials = order
  .map((name) => {
    const key = Object.keys(socialRaw).find((k) => k.includes(`/${name}.svg`));
    return key ? { name, svg: socialRaw[key] as string } : null;
  })
  .filter(Boolean) as { name: string; svg: string }[];

const p1 = 'Elit nisi in eleifend sed nisi. Pulvinar at orci, proin imperdiet commodo consectetur convallis risus.';
const p2 = 'Lorem ipsum dolor sit amet, consectetur adipiscing.';
const bio = 'Elit nisi in eleifend sed nisi. Pulvinar at orci, proin imperdiet commodo consectetur convallis risus. Sed condimentum enim dignissim adipiscing faucibus consequat, urna. Viverra purus et erat auctor aliquam. Risus, volutpat vulputate.';

// Icons for the header-content block (specs list + external link). Atoms only.
const iconRaw = import.meta.glob('../../assets/opek/icons/*.svg', { query: '?raw', import: 'default', eager: true });
const ic = (name: string): string => { const k = Object.keys(iconRaw).find((k) => k.endsWith(`/${name}.svg`)); return k ? (iconRaw[k] as string) : ''; };
const roomSpecs = [
  { icon: 'cadre', label: 'Oppervlakte', value: '240 m²' },
  { icon: 'people', label: 'Capaciteit', value: '196 personen' },
  { icon: 'lines', label: 'Verdieping', value: 'gelijkvloers' },
  { icon: 'setting-2', label: 'Technieker', value: 'Verplicht — inbegrepen in de prijs' },
  { icon: 'clock', label: 'Max. eindtijd', value: '23:00' },
];

function tileHeader(label: string) { return label; }
---
<div class="flex flex-col gap-8">

  <!-- Header content — with image -->
  <div class="flex flex-col gap-4" data-tile>
    <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
      <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Header content · with image — desktop / mobile<span class="vb-cap-id">#header-content</span></span>
      <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
    </div>
    <div class="vb-hdrc vb-hdrc--image" data-hdr>
      <div class="vb-hdrc__inner">
        <div class="vb-hdrc__content">
          <div class="vb-hdrc__text">
            <h1 class="vb-hdrc__title">Agenda</h1>
            <p class="vb-hdrc__intro">Events, voorstellingen, workshops en kampen in OPEK.</p>
          </div>
          <a href="#" class="vb-btn vb-ctam__btn vb-ctam__btn--lg vb-hdrc__cta">Call to action</a>
        </div>
        <div class="vb-hdrc__media"><div class="vb-image" set:html={placeholder}></div></div>
      </div>
    </div>
  </div>

  <!-- Header content — no image -->
  <div class="flex flex-col gap-4" data-tile>
    <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
      <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Header content · no image — desktop / mobile<span class="vb-cap-id">#header-content</span></span>
      <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
    </div>
    <div class="vb-hdrc vb-hdrc--plain" data-hdr>
      <div class="vb-hdrc__inner">
        <div class="vb-hdrc__content">
          <div class="vb-hdrc__text">
            <h1 class="vb-hdrc__title">Agenda</h1>
            <p class="vb-hdrc__intro">Events, voorstellingen, workshops en kampen in OPEK.</p>
          </div>
          <a href="#" class="vb-btn vb-ctam__btn vb-ctam__btn--lg vb-hdrc__cta">Call to action</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Header content block — variant 1: text + button -->
  <div class="flex flex-col gap-4" data-tile>
    <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
      <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Header content block · text — desktop / mobile<span class="vb-cap-id">#header-content-block</span></span>
      <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
    </div>
    <div class="vb-hcblock" data-hdr>
      <div class="vb-hcblock__inner">
        <div class="vb-hcblock__content">
          <h2 class="vb-hcblock__title">Café Entrepot</h2>
          <p class="vb-hcblock__text">Café Entrepot ligt in het hart van het OPEK-gebouw aan de Vaartkom in Leuven. Een plek om tot rust te komen, bij te praten of een hapje te eten — voor bezoekers van het gebouw én voor wie gewoon langskomt voor een drankje of een lunch. Het terras aan het water maakt het helemaal af.</p>
          <a href="#" class="vb-btn vb-ctam__btn vb-ctam__btn--lg vb-hcblock__cta">Bezoek cafeentrepot.be<span class="vb-hcblock__exticon" set:html={ic('export')}></span></a>
        </div>
        <div class="vb-hcblock__media"><div class="vb-image" set:html={placeholder}></div></div>
      </div>
    </div>
  </div>

  <!-- Header content block — variant 2: specs list -->
  <div class="flex flex-col gap-4" data-tile>
    <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
      <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Header content block · specs — desktop / mobile<span class="vb-cap-id">#header-content-block</span></span>
      <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
    </div>
    <div class="vb-hcblock" data-hdr>
      <div class="vb-hcblock__inner">
        <div class="vb-hcblock__content">
          <div class="vb-hcblock__head">
            <h2 class="vb-hcblock__title">Grote zaal</h2>
            <span class="vb-tag vb-hcblock__tag">Theaterzaal</span>
          </div>
          <ul class="vb-hcblock__specs">
            {roomSpecs.map((s) => (
              <li class="vb-hcblock__spec">
                <span class="vb-hcblock__speclabel"><span class="vb-hcblock__specicon" set:html={ic(s.icon)}></span>{s.label}</span>
                <span class="vb-hcblock__specval">{s.value}</span>
              </li>
            ))}
          </ul>
          <a href="#" class="vb-btn vb-ctam__btn vb-ctam__btn--lg vb-hcblock__cta">Zaal aanvragen</a>
        </div>
        <div class="vb-hcblock__media"><div class="vb-image" set:html={placeholder}></div></div>
      </div>
    </div>
  </div>

  <!-- Blog -->
  <div class="flex flex-col gap-4" data-tile>
    <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
      <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Blog — desktop / mobile<span class="vb-cap-id">#blog</span></span>
      <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
    </div>
    <div class="vb-hdr-blog" data-hdr>
      <div class="vb-hdr-blog__content">
        <div class="vb-hdr-blog__slot">
          <p class="vb-hdr-blog__date">wo 24 jun 2026</p>
          <p class="vb-hdr-blog__title">Nulla pariatur xcepteur sint occaecat cupidata lorem</p>
        </div>
        <div class="vb-hdr-blog__media">
          <div class="vb-hdr-blog__img"><div class="vb-image" set:html={placeholder}></div></div>
          <p class="vb-hdr-blog__caption">© Caption here</p>
        </div>
      </div>
    </div>
  </div>

</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var hdr = tile.querySelector('[data-hdr]');
      if (!t || !hdr || t.dataset.bound) return;
      t.dataset.bound = '1';
      t.addEventListener('change', function () { hdr.classList.toggle('is-mobile', t.checked); });
    });
  })();
</script>
