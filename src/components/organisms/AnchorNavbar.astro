---
/**
 * ORGANISMS — Anchor navbar (hanchor-navbar). OPEK Figma 18591:18202.
 * Brown bar (secondary-color-2/500). White Pitch caps links, gap 64.
 * Active link marked by a 5px brown-400 bar at the bottom of the bar. Tokens only.
 */
const links = ['Wat is OPEK', 'OPEK in cijfers', 'Missie en waarde', 'Onze werking', 'Team'];
const active = 0;
---
<div class="flex flex-col gap-4" data-tile data-antile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Anchor navbar — desktop / mobile<span class="vb-cap-id">#anchor-navbar</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>
  <nav class="vb-anchornav" aria-label="Op deze pagina">
    <div class="vb-anchornav__links">
      {links.map((label, i) => (
        <a href="#" class={`vb-anchornav__link${i === active ? ' is-active' : ''}`} aria-current={i === active ? 'true' : undefined}>{label}</a>
      ))}
    </div>
  </nav>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-antile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var el = tile.querySelector('.vb-anchornav');
      if (t && el) t.addEventListener('change', function () { el.classList.toggle('is-mobile', t.checked); });
    });
  })();
</script>
