---
/**
 * MOLECULES — Tiles / Quote (small-quote). OPEK Figma node 14278:85396.
 * Terracotta band, uppercase ITC Kabel quote (white), avatar + author in caps.
 */
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Quote — small (terracotta)<span class="vb-cap-id">#quote</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>

  <blockquote class="vb-quote">
    <p class="vb-quote__text">“Ultrices neque ipsum suspendisse lorem gravida dictum fusce placerat orcivitae cmauris rhoncus aenean lorem ipsum dolorsitamet”</p>
    <div class="vb-quote__who">
      <span class="vb-quote__avatar vb-image"></span>
      <div class="vb-quote__author">
        <div class="vb-quote__name">Firstname Lastname</div>
        <div class="vb-quote__role">Function, company name</div>
      </div>
    </div>
  </blockquote>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      if (t && !t.dataset.bound) {
        t.dataset.bound = '1';
        t.addEventListener('change', function () {
          tile.querySelectorAll('.vb-quote').forEach(function (el) { el.classList.toggle('is-mobile', t.checked); });
        });
      }
    });
  })();
</script>
