---
/**
 * MOLECULES — Tiles / Gallery (slider). OPEK Figma 14278:85395.
 * White, 928px. Rounded image (radius-xsmall, AR 350/233), tiny caption (#444),
 * nav row: dots on the left, prev/next arrow buttons on the right. Tokens only.
 * Interactive: arrows + dots move the track. Mobile switch narrows the tile.
 */
import arrow from '../../assets/opek/icons/arrow-right.svg?raw';
const placeholder = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const slides = [1, 2, 3];
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Gallery — desktop / mobile<span class="vb-cap-id">#gallery</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>

  <div class="vb-gallery vb-gallery--small" data-gallery>
    <div class="vb-gallery__group">
      <div class="vb-gallery__stage">
        <div class="vb-gallery__track">
          {slides.map((n) => (
            <div class="vb-gallery__slide"><div class="vb-image" set:html={placeholder}></div></div>
          ))}
        </div>
      </div>
      <p class="vb-gallery__caption">Image caption goes here</p>
      <div class="vb-gallery__nav">
        <div class="vb-dots">
          {slides.map((n, i) => (<span class={`vb-dot${i === 0 ? ' is-active' : ''}`} data-dot role="button" aria-label={`Slide ${n}`}></span>))}
        </div>
        <div class="vb-gallery__arrows">
          <button type="button" class="vb-icon-btn vb-icon-btn--flip" data-dir="prev" aria-label="Previous" set:html={arrow}></button>
          <button type="button" class="vb-icon-btn" data-dir="next" aria-label="Next" set:html={arrow}></button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      if (t && !t.dataset.bound) {
        t.dataset.bound = '1';
        t.addEventListener('change', function () {
          tile.querySelectorAll('.vb-gallery').forEach(function (el) { el.classList.toggle('is-mobile', t.checked); });
        });
      }
    });
    document.querySelectorAll('[data-gallery]').forEach(function (g) {
      var track = g.querySelector('.vb-gallery__track');
      var dots = g.querySelectorAll('[data-dot]');
      var n = track ? track.children.length : 0;
      var idx = 0;
      function go(i) {
        idx = (i + n) % n;
        if (track) track.style.transform = 'translateX(-' + (idx * 100) + '%)';
        dots.forEach(function (d, di) { d.classList.toggle('is-active', di === idx); });
      }
      g.querySelectorAll('[data-dir]').forEach(function (b) {
        b.addEventListener('click', function () { go(idx + (b.getAttribute('data-dir') === 'next' ? 1 : -1)); });
      });
      dots.forEach(function (d, di) { d.addEventListener('click', function () { go(di); }); });
      go(0);
    });
  })();
</script>
