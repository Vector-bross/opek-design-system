---
/**
 * MOLECULES — Tiles / IntroBanner (intro-text). OPEK Figma 18607:20014 (desktop),
 * 18301:17231 (mobile). White band, content max-width 1280. Big ITC Kabel Book
 * heading (64/48): first part black, tail grey (#aaa) that reveals to black on
 * scroll (word by word). Short rule to the left of the heading. Manrope body +
 * secondary outline button. Tokens only.
 */
const black = 'Cultureel verzamelgebouw aan de Vaartkom ';
const grey = '- waar bewoners, voorstellingen, workshops en café samenkomen.';
const greyWords = grey.split(' ');
const body = 'Ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occa.';
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">IntroBanner — desktop / mobile<span class="vb-cap-id">#introbanner</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>

  <div class="vb-introtext" data-reveal>
    <div class="vb-introtext__banner">
      <span class="vb-introtext__line" aria-hidden="true"></span>
      <h2 class="vb-introtext__heading">
        <span class="vb-introtext__black">{black}</span><span class="vb-introtext__reveal">{greyWords.map((w) => (<span class="vb-rw">{w} </span>))}</span>
      </h2>
    </div>
    <div class="vb-introtext__desc">
      <p class="vb-introtext__text">{body}</p>
      <a href="#" class="vb-btn vb-btn--secondary vb-btn--small">Meer over Opek</a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var intro = tile.querySelector('.vb-introtext');
      if (t && intro) t.addEventListener('change', function () { intro.classList.toggle('is-mobile', t.checked); });
    });
    document.querySelectorAll('[data-reveal]').forEach(function (el) {
      var words = Array.prototype.slice.call(el.querySelectorAll('.vb-rw'));
      if (!words.length) return;
      function update() {
        var r = el.getBoundingClientRect();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        // progress: 0 when block bottom enters viewport bottom, 1 when block top reaches ~35% of viewport
        var p = (vh - r.top) / (vh * 0.85);
        p = Math.max(0, Math.min(1, p));
        var n = Math.round(p * words.length);
        for (var i = 0; i < words.length; i++) words[i].classList.toggle('is-on', i < n);
      }
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    });
  })();
</script>
