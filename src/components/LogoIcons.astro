---
/**
 * Logo & Icons (ATOMS) — OPEK.
 * Logo (light + dark), the "graphic material" brand logos, and the OPEK icon
 * set (common, numbered, social). SVGs are inlined (?raw) so they render in the
 * offline preview and stay recolorable / downloadable. Brand logos are PNG,
 * embedded as data URIs at build.
 */
import fs from 'node:fs';
import path from 'node:path';
import logo from '../assets/opek/logo.svg?raw';

const iconsRaw = import.meta.glob('../assets/opek/icons/*.svg', { query: '?raw', import: 'default', eager: true });
const socialRaw = import.meta.glob('../assets/opek/icons/social/*.svg', { query: '?raw', import: 'default', eager: true });
const numberedRaw = import.meta.glob('../assets/opek/icons/numbered/*.svg', { query: '?raw', import: 'default', eager: true });

const clean = (p: string) => p.split('/').pop()!.replace('.svg', '');
const icons = Object.entries(iconsRaw).map(([p, svg]) => ({ name: clean(p), svg })).sort((a, b) => a.name.localeCompare(b.name));
const social = Object.entries(socialRaw).map(([p, svg]) => ({ name: clean(p), svg })).sort((a, b) => a.name.localeCompare(b.name));
const numbered = Object.entries(numberedRaw).map(([p, svg]) => ({ name: clean(p), svg })).sort((a, b) => Number(a.name) - Number(b.name));

// Graphic-material brand logos (PNG) → data URIs so they show offline too.
const brandDir = path.join(process.cwd(), 'src/assets/opek/brand');
let brandLogos: { name: string; src: string }[] = [];
try {
  brandLogos = fs.readdirSync(brandDir)
    .filter((f) => f.endsWith('.png'))
    .sort()
    .map((name) => ({
      name: name.replace('.png', ''),
      src: `data:image/png;base64,${fs.readFileSync(path.join(brandDir, name)).toString('base64')}`,
    }));
} catch (e) { brandLogos = []; }

const dl = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 12 5 5 5-5"/><path d="M5 21h14"/></svg>`;
---
<div class="flex flex-col gap-10">

  <!-- Company Logo -->
  <section class="flex flex-col gap-4">
    <h3 class="text-sm font-medium uppercase tracking-wide text-base-content/60">Company Logo</h3>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="vb-dlcell vb-logo-swatch flex items-center justify-center rounded border border-base-300 bg-base-100 p-10" data-dl data-name="opek-logo">
        <button class="vb-dl" aria-label="Download SVG" title="Download SVG" set:html={dl}></button>
        <span class="vb-logo-mark" set:html={logo}></span>
      </div>
      <div class="vb-dlcell vb-logo-swatch flex items-center justify-center rounded p-10" style="background: var(--vb-color-scheme-1-bg-inverse);" data-dl data-name="opek-logo-inverse">
        <button class="vb-dl vb-dl--onDark" aria-label="Download SVG" title="Download SVG" set:html={dl}></button>
        <span class="vb-logo-mark vb-logo-mark--invert" set:html={logo}></span>
      </div>
    </div>
  </section>

  {brandLogos.length > 0 && (
    <section class="flex flex-col gap-4">
      <h3 class="text-sm font-medium uppercase tracking-wide text-base-content/60">Graphic material — logos</h3>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {brandLogos.map((b) => (
          <div class="flex items-center justify-center rounded border border-base-300 bg-base-100 px-6 py-8">
            <img src={b.src} alt={b.name} class="max-h-16 w-auto object-contain" />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Common icons -->
  <section class="flex flex-col gap-4">
    <h3 class="text-sm font-medium uppercase tracking-wide text-base-content/60">Icons — Common</h3>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
      {icons.map((ic) => (
        <div class="vb-dlcell flex flex-col items-center gap-3 rounded border border-base-300 bg-base-100 p-4" data-dl data-name={ic.name}>
          <button class="vb-dl" aria-label="Download SVG" title="Download SVG" set:html={dl}></button>
          <div class="vb-icon-swatch flex h-12 items-center justify-center" set:html={ic.svg} />
          <span class="font-mono text-[11px] text-base-content/60 text-center break-all">{ic.name}</span>
        </div>
      ))}
    </div>
  </section>

  {numbered.length > 0 && (
    <section class="flex flex-col gap-4">
      <h3 class="text-sm font-medium uppercase tracking-wide text-base-content/60">Numbered</h3>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
        {numbered.map((ic) => (
          <div class="vb-dlcell flex flex-col items-center gap-3 rounded border border-base-300 bg-base-100 p-4" data-dl data-name={`number-${ic.name}`}>
            <button class="vb-dl" aria-label="Download SVG" title="Download SVG" set:html={dl}></button>
            <div class="vb-icon-swatch flex h-12 items-center justify-center" set:html={ic.svg} />
            <span class="font-mono text-[11px] text-base-content/60">{ic.name}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  {social.length > 0 && (
    <section class="flex flex-col gap-4">
      <h3 class="text-sm font-medium uppercase tracking-wide text-base-content/60">Social media</h3>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {social.map((ic) => (
          <div class="vb-dlcell flex flex-col items-center gap-3 rounded border border-base-300 bg-base-100 p-4" data-dl data-name={`social-${ic.name}`}>
            <button class="vb-dl" aria-label="Download SVG" title="Download SVG" set:html={dl}></button>
            <div class="vb-social-swatch" set:html={ic.svg} />
            <span class="font-mono text-[11px] text-base-content/60">{ic.name}</span>
          </div>
        ))}
      </div>
    </section>
  )}

</div>

<script is:inline>
  (function () {
    function svgString(el) {
      var svg = el.querySelector('svg');
      if (!svg) return '';
      var clone = svg.cloneNode(true);
      if (!clone.getAttribute('xmlns')) clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
      return '<?xml version="1.0" encoding="UTF-8"?>\n' + clone.outerHTML;
    }
    document.querySelectorAll('.vb-dl').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault(); e.stopPropagation();
        var cell = btn.closest('[data-dl]');
        if (!cell) return;
        var str = svgString(cell);
        if (!str) return;
        var blob = new Blob([str], { type: 'image/svg+xml;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url; a.download = (cell.getAttribute('data-name') || 'icon') + '.svg';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      });
    });
  })();
</script>
