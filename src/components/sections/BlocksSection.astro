---
/**
 * ORGANISMS · Section-blocks (#blocks-section) — "Missie en waarde".
 * Faithful to Figma 18608:20024. White, max-width 1280, 50/50: title left,
 * right = intro (bold lead + body) + 2×2 grid of titled blocks (H5 title +
 * body, collapsed 1px black borders). Atoms + tokens only.
 */
const lead = 'OPEK wil een participatief cultuurhuis zijn dat verbindt.';
const body = 'Een plek waar disciplines, makers en publiek samenkomen en waar kruisbestuiving tussen werkingen vanzelf ontstaat — een open, laagdrempelig huis aan het water, voor iedereen.';
const blocks = [
  { title: 'Verbinden', text: 'OPEK brengt makers, publiek en buurt samen onder één dak.' },
  { title: 'Kruisbestuiving', text: 'Disciplines en werkingen ontmoeten elkaar en versterken mekaar' },
  { title: 'Participatie', text: 'Een participatief cultuurhuis waar iedereen kan deelnemen.' },
  { title: 'Laagdrempelig', text: 'Een open, toegankelijke plek aan het water.' },
];
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Section · blocks — desktop / mobile<span class="vb-cap-id">#blocks-section</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>

  <div class="vb-blocksec" data-sec>
    <h2 class="vb-blocksec__title">Missie en waarde</h2>
    <div class="vb-blocksec__body">
      <div class="vb-blocksec__intro">
        <p class="vb-blocksec__lead">{lead}</p>
        <p class="vb-blocksec__text">{body}</p>
      </div>
      <div class="vb-blocksec__grid">
        {blocks.map((b) => (
          <div class="vb-blocksec__cell">
            <h3 class="vb-blocksec__celltitle">{b.title}</h3>
            <p class="vb-blocksec__celltext">{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var sec = tile.querySelector('[data-sec]');
      if (!t || !sec || t.dataset.bound) return;
      t.dataset.bound = '1';
      t.addEventListener('change', function () { sec.classList.toggle('is-mobile', t.checked); });
    });
  })();
</script>
