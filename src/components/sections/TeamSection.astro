---
/**
 * ORGANISMS · Team (#team-section) — "Team". Dark teal band, H2 white title,
 * bordered row of 3 vertical cards (portrait image / name H5 / role). Same
 * vertical-card family as news, simplified. Figma 18286:16096. Tokens only.
 */
const placeholder = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const members = [
  { name: 'Quinten', role: 'Gebouw & ICT' },
  { name: 'Lisanne', role: 'Zaalhuur, planning & administratie' },
  { name: 'Kayin', role: 'Communicatie' },
];
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Team section — desktop / mobile<span class="vb-cap-id">#team-section</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>

  <div class="vb-teamrow" data-sec>
    <div class="vb-teamrow__inner">
      <h2 class="vb-teamrow__title">Team</h2>

      <div class="vb-teamrow__grid">
        {members.map((m) => (
          <article class="vb-teamcard">
            <div class="vb-teamcard__img"><div class="vb-image" set:html={placeholder}></div></div>
            <div class="vb-teamcard__content">
              <h3 class="vb-teamcard__name">{m.name}</h3>
              <p class="vb-teamcard__role">{m.role}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var sec = tile.querySelector('[data-sec]');
      if (!t || !sec || t.dataset.bound) return;
      t.dataset.bound = '1';
      t.addEventListener('change', function () { sec.classList.toggle('is-mobile', t.checked); });
    });
  })();
</script>
