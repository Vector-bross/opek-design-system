---
/**
 * ORGANISMS · News (#news-section) — "Laatste nieuws". Title (display-2) + a
 * bordered row of 3 vertical news cards (image / date / H5 title / excerpt),
 * centered outline button below. Figma 18261:12271. Atoms/molecules/tokens only.
 */
const placeholder = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const desc = 'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt ...';
const cards = [
  { date: 'wo 24 jun 2026', title: 'Elit esse cillepteur sint occaecat cupidata lorem' },
  { date: 'wo 24 jun 2026', title: 'Uptate velit esste velite cillum dolore eu fugiat ipsuma' },
  { date: 'wo 24 jun 2026', title: 'Nulla pariatur xcepteur sint occaecat cupidata lorem' },
];
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">News section — desktop / mobile<span class="vb-cap-id">#news-section</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>

  <div class="vb-newsrow" data-sec>
    <div class="vb-newsrow__inner">
      <h2 class="vb-newsrow__title">Laatste nieuws</h2>

      <div class="vb-newsrow__grid">
        {cards.map((c) => (
          <article class="vb-newscard">
            <div class="vb-newscard__img"><div class="vb-image" set:html={placeholder}></div></div>
            <div class="vb-newscard__content">
              <span class="vb-newscard__date">{c.date}</span>
              <h3 class="vb-newscard__title">{c.title}</h3>
              <p class="vb-newscard__desc">{desc}</p>
            </div>
          </article>
        ))}
      </div>

      <a href="#" class="vb-btn vb-btn--secondary vb-newsrow__cta">Alle niews</a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var sec = tile.querySelector('[data-sec]');
      if (!t || !sec || t.dataset.bound) return;
      t.dataset.bound = '1';
      t.addEventListener('change', function () { sec.classList.toggle('is-mobile', t.checked); });
    });
  })();
</script>
