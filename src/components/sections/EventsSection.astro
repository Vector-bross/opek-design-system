---
/**
 * ORGANISMS · Events (#events) — "Eerstvolgende events". Title + intro, then a
 * bordered block: featured event card (left) + 3 horizontal event cards (right),
 * centered outline button below. Figma 18261:12273. Atoms/molecules/tokens only.
 */
import iCal from '../../assets/opek/icons/calendar.svg?raw';
import iVenue from '../../assets/opek/icons/house-2.svg?raw';
import iRoom from '../../assets/opek/icons/location-sharp.svg?raw';
const placeholder = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const cards = [
  { tag: 'Voorstellingen', title: 'Theatervoorstelling', meta: [{ icon: iCal, t: 'wo 24 jun 2026' }, { icon: iVenue, t: 'Kunst in huis' }, { icon: iRoom, t: 'Grote zaal' }] },
  { tag: "Expo's", title: 'Expo: beeldend werk', meta: [{ icon: iCal, t: 'vr 26 jun 2026' }, { icon: iVenue, t: 'Degarage' }, { icon: iRoom, t: 'Kleine zaal' }] },
  { tag: 'Concerten', title: 'Najaarsconcert', meta: [{ icon: iCal, t: 'za 27 jun 2026' }, { icon: iVenue, t: 'Degarage' }, { icon: iRoom, t: 'Galerij' }] },
];
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Events — desktop / mobile<span class="vb-cap-id">#events</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>

  <div class="vb-events" data-sec>
    <div class="vb-events__inner">
    <div class="vb-events__head">
      <h2 class="vb-events__title">Eerstvolgende events</h2>
      <p class="vb-events__intro">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique.</p>
    </div>

    <div class="vb-events__content">
      <!-- Featured -->
      <div class="vb-events__featured">
        <article class="vb-evcard">
          <div class="vb-evcard__img"><div class="vb-image" set:html={placeholder}></div></div>
          <div class="vb-evcard__body">
            <span class="vb-tag vb-tag--green">Voorstellingen</span>
            <div class="vb-evmeta">
              <span class="vb-evmeta__item"><span class="vb-evmeta__icon" set:html={iCal}></span>wo 24 jun 2026</span>
              <span class="vb-evmeta__item"><span class="vb-evmeta__icon" set:html={iRoom}></span>Grote zaal</span>
            </div>
            <h3 class="vb-evcard__title">Theatervoorstelling</h3>
          </div>
        </article>
      </div>

      <!-- Horizontal list -->
      <div class="vb-events__list">
        {cards.map((c) => (
          <a href="#" class="vb-evcard-h">
            <div class="vb-evcard-h__img"><div class="vb-image" set:html={placeholder}></div></div>
            <div class="vb-evcard-h__body">
              <span class="vb-tag vb-tag--green">{c.tag}</span>
              <div class="vb-evmeta">
                {c.meta.map((m) => (<span class="vb-evmeta__item"><span class="vb-evmeta__icon" set:html={m.icon}></span>{m.t}</span>))}
              </div>
              <h3 class="vb-evcard-h__title">{c.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>

    <a href="#" class="vb-btn vb-btn--secondary vb-events__cta">Volledige agenda</a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var sec = tile.querySelector('[data-sec]');
      if (!t || !sec || t.dataset.bound) return;
      t.dataset.bound = '1';
      t.addEventListener('change', function () { sec.classList.toggle('is-mobile', t.checked); });
    });
  })();
</script>
