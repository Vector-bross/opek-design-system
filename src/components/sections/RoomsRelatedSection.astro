---
/**
 * ORGANISMS · Related rooms (#rooms-related) — "Andere ruimtes". Teal band,
 * white H2 title, 3 vertical cards (image / green tag / name H5 / info / small
 * outline button), centered outline button below (white on dark). Same vertical
 * card family. Figma 18369:16398. Atoms/molecules/tokens only.
 */
const placeholder = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const rooms = [1, 2, 3];
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Related rooms — desktop / mobile<span class="vb-cap-id">#rooms-related</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>

  <div class="vb-roomrow" data-sec>
    <div class="vb-roomrow__inner">
      <h2 class="vb-roomrow__title">Andere ruimtes</h2>

      <div class="vb-roomrow__grid">
        {rooms.map(() => (
          <article class="vb-roomcard">
            <div class="vb-roomcard__img"><div class="vb-image" set:html={placeholder}></div></div>
            <div class="vb-roomcard__content">
              <div class="vb-roomcard__text">
                <span class="vb-tag vb-tag--green vb-roomcard__tag">Voorstellingen</span>
                <h3 class="vb-roomcard__name">Grote zaal</h3>
                <p class="vb-roomcard__info">240 m² &middot; 196 personen<br />Verdieping: gelijkvloers</p>
              </div>
              <a href="#" class="vb-btn vb-btn--secondary vb-btn--small vb-roomcard__btn">Bekijk deze ruimte</a>
            </div>
          </article>
        ))}
      </div>

      <div class="on-dark vb-roomrow__cta-wrap">
        <a href="#" class="vb-btn vb-btn--secondary vb-roomrow__cta">Bekijk alle ruimtes</a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var sec = tile.querySelector('[data-sec]');
      if (!t || !sec || t.dataset.bound) return;
      t.dataset.bound = '1';
      t.addEventListener('change', function () { sec.classList.toggle('is-mobile', t.checked); });
    });
  })();
</script>
