---
/**
 * ORGANISMS · CKEditorStyles — rich-text (CKEditor output) styles.
 * Faithful to Figma 18590:17649. Composes existing atoms/molecules/organisms only:
 * headings & body (atoms), highlighted text, date list, image + caption,
 * NumberedList (molecule), Quote (terracotta molecule). Tokens only.
 */
import n1 from '../../assets/icons/numbered/01.svg?raw';
import n2 from '../../assets/icons/numbered/02.svg?raw';
import n3 from '../../assets/icons/numbered/03.svg?raw';
const placeholder = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const dates = [
  { day: 'vr 3 jul 2026', time: '20:00' },
  { day: 'za 4 jul 2026', time: '19:30' },
  { day: 'zo 5 jul 2026', time: '15:00' },
];
const numbered = [
  { badge: n1, text: 'Dolor enim eu tortor urna sed duis nullaliquam vestibulum' },
  { badge: n2, text: 'Proin imperdiet commodo consectetur convallis risus' },
  { badge: n3, text: 'Dolor enim eu tortor urna sed duis nullaliquam vestibulum' },
];
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">CKEditor styles — rich text<span class="vb-cap-id">#ckeditor-styles</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>

  <div class="vb-rte" data-sec>
    <div class="vb-rte__inner">
      <p class="vb-rte__lead">Dolor enim eu tortor urna sed duis nulla. Aliquam vestibulum, nulla odio nisl vitae. In aliquet pellentesque aenean hac vestibulum turpis mi bibendum diam. Tempor integer aliquam in vitae malesuada fringilla.</p>
      <p class="vb-rte__p">Mi tincidunt elit, id quisque ligula ac diam, amet. <a href="#" class="vb-rte__link">Vel etiam suspendisse morbi eleifend faucibus</a> eget vestibulum felis. Dictum quis montes, sit sit. Tellus aliquam enim urna, etiam. Mauris posuere vulputate arcu amet, vitae nisi, tellus tincidunt.</p>

      <h2 class="vb-rte__h2">Heading 2</h2>
      <p class="vb-rte__p">Eget quis mi enim, leo lacinia pharetra, semper. Eget in volutpat mollis at volutpat lectus velit, sed auctor. Porttitor fames arcu quis fusce augue enim. Quis at habitant diam at. Suscipit tristique risus, at donec. In turpis vel et quam imperdiet. Ipsum molestie aliquet sodales id est ac volutpat.</p>

      <ul class="vb-rte__dates">
        {dates.map((d) => (
          <li class="vb-rte__date"><span class="vb-rte__dateday">{d.day}</span><span class="vb-rte__datesep">—</span><span class="vb-rte__datetime">{d.time}</span></li>
        ))}
      </ul>

      <p class="vb-rte__p">Tristique odio senectus nam posuere ornare leo metus, ultricies. Blandit duis ultricies vulputate morbi feugiat cras placerat elit. Aliquam tellus lorem sed ac. Montes, sed mattis pellentesque suscipit accumsan. Cursus viverra aenean magna risus elementum faucibus molestie pellentesque. Arcu ultricies sed mauris vestibulum.</p>

      <figure class="vb-rte__figure">
        <div class="vb-image" set:html={placeholder}></div>
        <figcaption class="vb-rte__caption">Image caption goes here</figcaption>
      </figure>

      <h3 class="vb-rte__h3">Heading 3</h3>
      <p class="vb-rte__p">Morbi sed imperdiet in ipsum, adipiscing elit dui lectus. Tellus id scelerisque est ultricies ultricies. Duis est sit sed leo nisl, blandit elit sagittis. Quisque tristique consequat quam sed. Nisl at scelerisque amet nulla purus habitasse.</p>

      <h4 class="vb-rte__h4">Heading 4</h4>
      <p class="vb-rte__p">Eget quis mi enim, leo lacinia pharetra, semper. Eget in volutpat mollis at volutpat lectus velit, sed auctor. Porttitor fames arcu quis fusce augue enim. Quis at habitant diam at. Suscipit tristique risus, at donec. In turpis vel et quam imperdiet. Ipsum molestie aliquet sodales id est ac volutpat.</p>
      <p class="vb-rte__p">Tristique odio senectus nam posuere ornare leo metus, ultricies. Blandit duis ultricies vulputate morbi feugiat cras placerat elit. Aliquam tellus lorem sed ac. Montes, sed mattis pellentesque suscipit accumsan. Cursus viverra aenean magna risus elementum faucibus molestie pellentesque.</p>

      <ul class="vb-numlist">
        {numbered.map((it) => (
          <li class="vb-numlist__item"><span class="vb-numlist__badge" set:html={it.badge}></span><span class="vb-numlist__text">{it.text}</span></li>
        ))}
      </ul>

      <p class="vb-rte__p">Nunc sed faucibus bibendum feugiat sed interdum. Ipsum egestas condimentum mi massa. In tincidunt pharetra consectetur sed duis facilisis metus. Etiam egestas in nec sed et. Quis lobortis at sit dictum eget nibh tortor commodo cursus.</p>
      <p class="vb-rte__p">Tristique odio senectus nam posuere ornare leo metus, ultricies. Blandit duis ultricies vulputate morbi feugiat cras placerat elit. Aliquam tellus lorem sed ac. Montes, sed mattis pellentesque suscipit accumsan.</p>

      <figure class="vb-quote vb-rte__quoteblock">
        <blockquote class="vb-quote__text">“Ultrices neque ipsum suspendisse lorem gravida dictum fusce placerat orcivitae cmauris rhoncus aenean lorem ipsum dolorsitamet”</blockquote>
        <div class="vb-quote__who">
          <span class="vb-quote__avatar vb-image" set:html={placeholder}></span>
          <div class="vb-quote__author">
            <span class="vb-quote__name">Firstname Lastname</span>
            <span class="vb-quote__role">Function, company name</span>
          </div>
        </div>
      </figure>

      <h6 class="vb-rte__h6">Heading 6</h6>
      <p class="vb-rte__p">Nunc sed faucibus bibendum feugiat sed interdum. Ipsum egestas condimentum mi massa. In tincidunt pharetra consectetur sed duis facilisis metus. Etiam egestas in nec sed et. Quis lobortis at sit dictum eget nibh tortor commodo cursus.</p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var sec = tile.querySelector('[data-sec]');
      if (!t || !sec || t.dataset.bound) return;
      t.dataset.bound = '1';
      t.addEventListener('change', function () { sec.classList.toggle('is-mobile', t.checked); });
    });
  })();
</script>
