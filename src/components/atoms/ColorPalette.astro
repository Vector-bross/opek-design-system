---
/**
 * Color palette (ATOMS — Colors). Each swatch is driven directly by a --vb-* token,
 * so this display always reflects tokens.css (the source of truth).
 */
type Swatch = { name: string; token: string };
type Group = { title: string; swatches: Swatch[] };

const groups: Group[] = [
  {
    title: 'Neutrals',
    swatches: [
      { name: 'White', token: '--vb-color-white' },
      { name: 'Lightest', token: '--vb-color-neutral-lightest' },
      { name: 'Lighter', token: '--vb-color-neutral-lighter' },
      { name: 'Light', token: '--vb-color-neutral-light' },
      { name: 'Neutral', token: '--vb-color-neutral' },
      { name: 'Dark', token: '--vb-color-neutral-dark' },
      { name: 'Darker', token: '--vb-color-neutral-darker' },
      { name: 'Darkest', token: '--vb-color-neutral-darkest' },
    ],
  },
  {
    title: 'Primary color 1 · Light (green)',
    swatches: [
      { name: '400', token: '--vb-green-light-400' },
      { name: '500', token: '--vb-green-light-500' },
      { name: '600', token: '--vb-green-light-600' },
      { name: '700', token: '--vb-green-light-700' },
    ],
  },
  {
    title: 'Primary color 1 · Dark (green)',
    swatches: [
      { name: '300', token: '--vb-green-dark-300' },
      { name: '400', token: '--vb-green-dark-400' },
      { name: '500', token: '--vb-green-dark-500' },
      { name: '600', token: '--vb-green-dark-600' },
      { name: '700', token: '--vb-green-dark-700' },
    ],
  },
  {
    title: 'Primary color 2 · Terracotta',
    swatches: [
      { name: '200', token: '--vb-accent-terracotta-200' },
      { name: '500', token: '--vb-accent-terracotta-500' },
      { name: '600', token: '--vb-accent-terracotta-600' },
    ],
  },
  {
    title: 'Secondary color 1 · Teal',
    swatches: [
      { name: '200', token: '--vb-accent-teal-200' },
      { name: '400', token: '--vb-accent-teal-400' },
      { name: '500', token: '--vb-accent-teal-500' },
      { name: '600', token: '--vb-accent-teal-600' },
      { name: '700', token: '--vb-accent-teal-700' },
    ],
  },
  {
    title: 'Secondary color 2 · Brown',
    swatches: [
      { name: '400', token: '--vb-accent-brown-400' },
      { name: '500', token: '--vb-accent-brown-500' },
      { name: '600', token: '--vb-accent-brown-600' },
    ],
  },
  {
    title: 'Secondary color 3 · Magenta',
    swatches: [
      { name: '500', token: '--vb-accent-magenta-500' },
    ],
  },
  {
    title: 'State',
    swatches: [
      { name: 'Success', token: '--vb-color-success' },
      { name: 'Danger', token: '--vb-color-danger' },
      { name: 'Focus', token: '--vb-color-focus' },
    ],
  },
  {
    title: 'Semantic · Color Scheme 1',
    swatches: [
      { name: 'Foreground', token: '--vb-color-scheme-1-foreground' },
      { name: 'Emphasis', token: '--vb-color-scheme-1-emphasis-color' },
      { name: 'Body', token: '--vb-color-scheme-1-body-color' },
      { name: 'Secondary', token: '--vb-color-scheme-1-secondary-color' },
      { name: 'Text brand', token: '--vb-color-scheme-1-text-brand-primary' },
      { name: 'Bg body', token: '--vb-color-scheme-1-bg-body' },
      { name: 'Bg secondary', token: '--vb-color-scheme-1-bg-secondary' },
      { name: 'Bg inverse', token: '--vb-color-scheme-1-bg-inverse' },
      { name: 'Border', token: '--vb-color-scheme-1-border-color' },
      { name: 'Border subtle', token: '--vb-color-scheme-1-border-color-subtle' },
    ],
  },
];
---
<div class="flex flex-col gap-8">
  {groups.map((group) => (
    <div class="flex flex-col gap-3">
      <h3 class="text-sm font-medium uppercase tracking-wide text-base-content/60">{group.title}</h3>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
        {group.swatches.map((s) => (
          <div class="overflow-hidden rounded-box border border-base-300 bg-base-100">
            <div class="h-16 w-full" style={`background: var(${s.token})`}></div>
            <div class="px-3 py-2">
              <div class="text-sm font-medium">{s.name}</div>
              <div class="font-mono text-[11px] text-base-content/60">{s.token}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>
