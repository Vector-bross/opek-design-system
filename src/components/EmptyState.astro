---
/**
 * MOLECULES — EmptyState (404). Tokens only. Centered.
 * Oups! (h1 blue) + subtitle (h2 #444) + outlined 404 (display-error, stroke) + button.
 */
---
<div class="flex flex-col gap-4" data-tile data-empty404>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Empty state (404) — desktop / mobile<span class="vb-cap-id">#empty-state-404</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>
  <div class="vb-404-band">
    <div class="vb-404">
      <div class="vb-404__msg">
        <p class="vb-404__oups">Ooops!</p>
        <p class="vb-404__title">Er is hier niets!</p>
      </div>
      <p class="vb-404__num">404</p>
      <div class="vb-404__actions"><a href="#" class="vb-btn vb-btn--small vb-ctam__btn">Terug naar homepagina</a></div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-empty404]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      if (!t) return;
      t.addEventListener('change', function () {
        tile.querySelectorAll('.vb-404').forEach(function (el) { el.classList.toggle('is-mobile', t.checked); });
      });
    });
  })();
</script>
